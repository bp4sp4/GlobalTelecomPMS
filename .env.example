# Supabase Postgres (Prisma)
# Supabase 대시보드 > Project Settings > Database > Connection string 참고
# 앱 런타임(pooled, 6543):
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 마이그레이션/스키마 푸시(direct/session, 5432):
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Supabase (클라이언트/스토리지 — 방송사진 업로드용)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"

# 세션 서명용 시크릿 (아무 랜덤 문자열, 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="change-me-to-a-long-random-string"
